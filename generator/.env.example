# Supabase
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

# Storage bucket name (create this in Supabase Dashboard → Storage)
SUPABASE_STORAGE_BUCKET=match-videos

# How many days ahead to query matches (default: 1 = today only)
DAYS_AHEAD=1

# Comma-separated league IDs to generate videos for (e.g. 71,72,13).
# If unset or empty, videos are generated for all leagues.
ENABLED_LEAGUE_IDS=
